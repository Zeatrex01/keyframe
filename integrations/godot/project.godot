; Keyframe add-on demo project for Godot 4.2+. Open this folder in Godot and press Play.

config_version=5

[application]

config/name="Keyframe for Godot demo"
run/main_scene="res://demo/main.tscn"
config/features=PackedStringArray("4.2")

[editor_plugins]

enabled=PackedStringArray("res://addons/keyframe/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.078, 0.071, 0.11, 1)
